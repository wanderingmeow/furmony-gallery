{
  "name": "furmony-gallery",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "node node_modules/typescript-7/bin/tsc -b",
    "build": "npm run typecheck && vite build && cp dist/index.html dist/404.html",
    "preview": "vite preview",
    "test": "vitest run",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@ant-design/icons-svg": "^4.6.0",
    "@dschz/solid-uplot": "^0.5.2",
    "@panzoom/panzoom": "^4.6.2",
    "@solid-primitives/i18n": "^2.2.1",
    "@solidjs/router": "^1.0.0",
    "@su-engineering/heic": "^0.3.0",
    "solid-js": "^1.9.17",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-solid": "^0.20.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "prettier": "3.10.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-7": "npm:typescript@^7.0.2",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.4",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.3"
  }
}
