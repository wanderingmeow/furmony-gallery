# Copy this to .env and fill it in. This file is committed, .env is not.
# A value can also come from a real environment variable on the build machine.
# Leave one out and the feature that needs it stays out of the bundle.

# 设定搜索: where a search sentence is sent, usually a service you run yourself.
SEARCH_URL=

# 详细描述 translation: the key of the translate widget, which the official site also ships in
# its own bundle.
TRANSLATE_KEY=

# Local listing copies from agent/ instead of the live site. The dev server uses them without this.
# Set it for both commands: `VITE_MOCK=1 npm run build` writes dist-mock, and
# `VITE_MOCK=1 npm run preview` serves that directory. The published build never sets it, and the
# publish script reads dist.
VITE_MOCK=
